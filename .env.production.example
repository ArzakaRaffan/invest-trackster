# ==== Database ====
POSTGRES_PASSWORD=replace-with-local-db-password

# ==== Auth ====
JWT_SECRET=replace-with-random-secret-at-least-32-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-unique-admin-password

# ==== Owner info ====
OWNER_FULL_NAME=

# ==== Gmail API OAuth2 ====
# Client ID/Secret SAMA seperti yang di lokal (project Google Cloud yang sama)
# TAPI redirect URI harus ditambah di Google Console: https://api.trackster.dev/gmail/callback
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=https://api.trackster.dev/gmail/callback

# ==== Split Bill scan struk (Claude vision via mwapi.dev, terpisah dari AI Trackster) ====
SPLITBILL_AI_API_KEY=
SPLITBILL_AI_BASE_URL=https://api.mwapi.dev
SPLITBILL_AI_MODEL=claude-sonnet-5

# ==== URLs ====
FRONTEND_URL=https://trackster.dev
NEXT_PUBLIC_API_URL=https://api.trackster.dev
NEXT_PUBLIC_SITE_URL=https://trackster.dev
COOKIE_DOMAIN=.trackster.dev
